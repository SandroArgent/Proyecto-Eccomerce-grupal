# Copiá este archivo como ".env" (en la carpeta api) y completá tus valores.
# El archivo .env real NUNCA se sube a GitHub (está en .gitignore).

PORT=3000

# ── Base de datos ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nombre_de_tu_base

# ── Claves para firmar tokens (usá textos largos y DISTINTOS entre sí) ──
JWT_SECRET_USUARIO=cambiar_por_un_texto_largo_y_aleatorio
JWT_SECRET_ADMIN=cambiar_por_otro_texto_largo_y_distinto
JWT_SECRET_RECUPERACION=cambiar_por_un_tercer_texto_distinto

# ── MÓDULO B: mensajería por mail ──
# Si dejás MAIL_HOST vacío, los mails NO se envían: se muestran en la consola
# del servidor ("modo prueba"). Sirve para desarrollar sin configurar nada.
#
# Para enviar mails DE VERDAD con Gmail:
#   1) Activá la verificación en 2 pasos en tu cuenta de Google.
#   2) Creá una "contraseña de aplicación": https://myaccount.google.com/apppasswords
#   3) Pegá esa contraseña de 16 letras en MAIL_PASS (NO uses tu contraseña normal).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=tucuenta@gmail.com
MAIL_PASS=

# Remitente que ven los clientes (opcional; Gmail igual usa tu cuenta real).
MAIL_FROM="Tienda de Música" <tucuenta@gmail.com>

# A quién le avisamos cuando entra un pedido nuevo (varios separados por coma).
# Si lo dejás vacío, se usan los emails de los administradores de la base.
MAIL_ADMIN=

# Nombre de la tienda que aparece en los mails.
NOMBRE_TIENDA=Tienda de Música

# Dirección del frontend (React). Se usa para armar los enlaces de los mails.
FRONTEND_URL=http://localhost:5173
